# control-plane
PORT=8787
DB_PATH=./control-plane.sqlite
AGENT_RUNTIME_IMAGE=crowcode/agent-runtime-base:1
SELF_WS_URL_FOR_RUNTIME=ws://host.docker.internal:8787/ws/agent-runtime
DOCKER_SOCKET_PATH=/var/run/docker.sock
# 32 random bytes, base64 -- e.g. `openssl rand -base64 32`
CONTROL_PLANE_SECRET_KEY=
# CORS origin(s) the Electron renderer connects from. A packaged app loads
# via file:// (Origin: null), so a local dev setup can leave this unset
# (defaults to the dev renderer at localhost:5173), but a packaged/remote
# setup needs '*' (or a comma-separated allowlist) here instead.
ELECTRON_RENDERER_URL_ORIGIN=

# S3 / MinIO (shared by control-plane and agent-runtime containers)
S3_BUCKET=crowcode-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://host.docker.internal:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=crowcode
S3_SECRET_ACCESS_KEY=crowcode-dev-secret

# electron
CONTROL_PLANE_HTTP_URL=http://localhost:8787
CONTROL_PLANE_WS_URL=ws://localhost:8787/ws/electron

# agent-runtime (also needs ANTHROPIC_API_KEY per the Claude Agent SDK)
ANTHROPIC_API_KEY=
